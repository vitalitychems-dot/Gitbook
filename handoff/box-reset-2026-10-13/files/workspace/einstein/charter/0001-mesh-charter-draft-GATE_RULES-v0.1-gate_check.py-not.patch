+From 919a13909d876983cc53047d7ef7e7774c6ec614 Mon Sep 17 00:00:00 2001
+From: Einstein <einstein@local>
+Date: Tue, 13 Oct 2026 04:08:56 -0500
+Subject: [PATCH] fix(embeddings): key the embedding cache on the whole text,
+ not a 32-bit hash of its first 500 chars
+
+---
+ .../src/__tests__/neural-embeddings.test.ts        | 10 ++++++++++
+ artifacts/api-server/src/lib/neural-embeddings.ts  | 14 +++++++-------
+ 2 files changed, 17 insertions(+), 7 deletions(-)
+
+diff --git a/artifacts/api-server/src/__tests__/neural-embeddings.test.ts b/artifacts/api-server/src/__tests__/neural-embeddings.test.ts
+index f3df16fa..669f595d 100644
+--- a/artifacts/api-server/src/__tests__/neural-embeddings.test.ts
++++ b/artifacts/api-server/src/__tests__/neural-embeddings.test.ts
+@@ -28,3 +28,13 @@ describe("neural embeddings", () => {
+     expect(maxDiff).toBeGreaterThan(0.01);
+   });
+ });
++
++describe("neural embedding cache key", () => {
++  it("texts sharing a 500-char prefix do not share a cached embedding", async () => {
++    delete process.env.TESSERA_EMBED_MODEL;
++    const prefix = `shared header ${Date.now()} `.padEnd(520, "x");
++    const a = await generateEmbedding(`${prefix} alpha consensus retrieval memory`);
++    const b = await generateEmbedding(`${prefix} omega scheduler annealing lattice`);
++    expect(a).not.toEqual(b);
++  });
++});
+diff --git a/artifacts/api-server/src/lib/neural-embeddings.ts b/artifacts/api-server/src/lib/neural-embeddings.ts
+index 33674e53..2fd2c5c8 100644
+--- a/artifacts/api-server/src/lib/neural-embeddings.ts
++++ b/artifacts/api-server/src/lib/neural-embeddings.ts
+@@ -28,13 +28,6 @@ const embeddingMetrics = {
+   errors: 0,
+ };
+ 
+-function hashText(text: string): string {
+-  let h = 0;
+-  const t = text.slice(0, 500).toLowerCase().trim();
+-  for (let i = 0; i < t.length; i++) h = ((h << 5) - h + t.charCodeAt(i)) | 0;
+-  return `emb-${Math.abs(h).toString(36)}`;
+-}
+-
+ const STOPWORDS = new Set([
+   "the","a","an","and","or","but","if","then","of","to","in","on","at","by","for","with","as","is","are","was","were","be","been","being","have","has","had","do","does","did","this","that","these","those","it","its","from","so","not","no","yes","i","you","he","she","we","they","them","us","our","your","their","my","me"
+ ]);
+@@ -48,6 +41,13 @@ function hashStr(s: string, seed = 2166136261): number {
+   return h >>> 0;
+ }
+ 
++function hashText(text: string): string {
++  // Key on the whole normalized text (two FNV-1a seeds + length). The old key hashed only the
++  // first 500 chars into 32 bits, so texts sharing a 500-char prefix got each other's embedding.
++  const t = text.toLowerCase().trim();
++  return `emb-${hashStr(t).toString(36)}-${hashStr(t, 0x9e3779b9).toString(36)}-${t.length.toString(36)}`;
++}
++
+ function tokenize(text: string): string[] {
+   return text
+     .toLowerCase()
+-- 
+2.47.3
+
