+  const needle = query.trim().toLowerCase();
+  const index = needle ? flat.toLowerCase().indexOf(needle.split(/\s+/)[0] ?? needle) : 0;
+  const start = Math.max(0, index - 80);
+  const slice = flat.slice(start, start + 240);
+  return start > 0 ? `…${slice}` : slice;
