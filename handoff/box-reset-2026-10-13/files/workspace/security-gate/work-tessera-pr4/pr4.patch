+    `duplicate_workspace_roots: ${duplicates.length}`,
+    ...duplicates.map((item) => `  - ${item}`),
+    `stale_app_references: ${stale.length}`,
+    ...stale.map((item) => `  - ${item}`),
+    `secret_shaped_paths: ${secrets.length}`,
+    ...secrets.map((item) => `  - ${item}`),
